{
  "framework": "vite",
  "buildCommand": "pnpm -r --filter @workspace/rankin-insulation run build && node -e \"require('fs').cpSync('artifacts/rankin-insulation/dist/public', 'public', {recursive: true})\"",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
